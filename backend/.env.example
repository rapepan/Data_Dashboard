PORT=4000
HOST=127.0.0.1

# ใช้เซ็น session (สุ่มยาว ๆ) — ห้ามว่างบนเครื่องจริง
AUTH_SECRET=
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=false

# ฐานข้อมูล HOSxP (อ่านอย่างเดียว) — ใช้ตรวจ login จาก opduser
HOSXP_HOST=
HOSXP_PORT=3306
HOSXP_USER=
HOSXP_PASSWORD=
HOSXP_DATABASE=hos
HOSXP_DB_CHARSET=utf8mb4
# groupname ใน opduser ที่เป็นผู้ดูแลระบบ (ค่าเริ่มต้น: ผู้ดูแลระบบ)
HOSXP_ADMIN_GROUP=

# แจ้งเตือนเรื่องที่แจ้งปัญหาเข้า Telegram (เว้นว่าง = ไม่ส่ง)
#   token จาก @BotFather · หา chat id ด้วย: npm run telegram:chat-id · ทดสอบ: npm run telegram:test
TELEGRAM_BOT_TOKEN=
# หลายปลายทางคั่นด้วย , (ส่วนตัว = เลขบวก, กลุ่ม = เลขลบ)
TELEGRAM_CHAT_ID=
# ลิงก์เว็บ https สำหรับปุ่ม "เปิดดูในระบบ" ใน Telegram (เว้นว่าง = ไม่มีปุ่ม)
APP_PUBLIC_URL=

# ที่พักผลรายงาน — ดึงจาก HOSxP มาเตรียมไว้ล่วงหน้า ผู้ใช้เปิดหน้าไม่ทำให้ HOSxP ถูก query ซ้ำ (cache/)
# รอบเตรียมข้อมูล (นาที) — ตรงเวลา :00/:30
CACHE_PREWARM_MINUTES=30
# อายุผลของช่วงที่รวมวันนี้ (นาที) / ช่วงในอดีต (ชั่วโมง)
CACHE_TTL_TODAY_MINUTES=30
CACHE_TTL_PAST_HOURS=24
# query ไป HOSxP พร้อมกันได้สูงสุด (ที่เหลือเข้าคิว)
HOSXP_MAX_CONCURRENT=2

# ประวัติการใช้งาน: เก็บในไฟล์หลักกี่วัน เก่ากว่านั้นย้ายเข้า data/audit-archive (แยกไฟล์รายเดือน ไม่ลบ)
AUDIT_KEEP_DAYS=180

# เฝ้าระวังเครื่อง (ข้อความ [เฝ้าระวัง] ในเทอร์มินัล backend)
#   backend ใช้ RAM เกิน (MB) · RAM ทั้งเครื่องเหลือน้อยกว่า (%) · โฟลเดอร์ data ใหญ่เกิน (MB) · IP เดียวส่ง request เกิน (ครั้ง/นาที)
MEM_WARN_MB=1024
MEM_FREE_WARN_PCT=5
DATA_WARN_MB=500
LOG_IP_RATE_PER_MIN=300

# โฟลเดอร์เก็บข้อมูลของระบบ (เว้นว่าง = backend/data)
DATA_DIR=
