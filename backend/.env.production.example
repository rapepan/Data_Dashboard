# ===== DATA BSTH — ค่าตั้งสำหรับเครื่อง server (production) =====
# คัดลอกเป็น backend/.env แล้วกรอกค่า:   cp backend/.env.production.example backend/.env && chmod 600 backend/.env
# ตรวจหลังกรอก:                        npm run check:connections   (โฟลเดอร์ backend)
# ★ = ต้องกรอก / ต้องเปลี่ยน · ค่าอื่นใช้ค่าเริ่มต้นได้ (ดูคำอธิบายทุกตัวใน .env.example)

# backend ฟังเฉพาะในเครื่อง — ผู้ใช้เข้าผ่าน nginx (พอร์ต 80/443) เท่านั้น
PORT=4000
HOST=127.0.0.1
NODE_ENV=production

# ★ ใช้เซ็น session — สุ่มใหม่ ห้ามใช้ค่าเดียวกับเครื่องพัฒนา:  openssl rand -hex 32
#   (เปลี่ยนค่านี้ = ทุกคนหลุดจากระบบ ต้อง login ใหม่)
AUTH_SECRET=
SESSION_IDLE_MINUTES=30
# true เมื่อเปิดเว็บผ่าน https (ดูส่วน HTTPS ใน deploy/nginx/bsth-dashboard.conf) · http ภายใน = false
COOKIE_SECURE=false

# ★ HOSxP — อ่านอย่างเดียว (ระบบตั้ง session READ ONLY ให้ทุกการเชื่อมต่อ) · server ต้องต่อถึงเครื่องนี้ได้
HOSXP_HOST=
HOSXP_PORT=3306
HOSXP_USER=
HOSXP_PASSWORD=
HOSXP_DATABASE=hos
HOSXP_DB_CHARSET=utf8mb4
HOSXP_ADMIN_GROUP=

# ★ ฐานข้อมูลของระบบเอง (อ่าน/เขียน) — แนะนำบัญชีที่มีสิทธิ์เฉพาะฐานนี้ ไม่ใช่บัญชีที่มีสิทธิ์ทั้ง server
#   รหัสผ่านมีอักขระพิเศษ ให้ใส่ในเครื่องหมาย "..."
DASHBOARD_DB_HOST=
DASHBOARD_DB_PORT=3306
DASHBOARD_DB_USER=
DASHBOARD_DB_PASSWORD=
DASHBOARD_DB_DATABASE=data_dashboard

# แจ้งเตือนเรื่องที่แจ้งปัญหาเข้า Telegram (เว้นว่าง = ไม่ส่ง) — server ต้องออกอินเทอร์เน็ตไป api.telegram.org ได้
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# แจ้งผู้ดูแลเมื่อระบบล่ม (ฐานข้อมูลต่อไม่ได้ / backend ดับ) — เว้นว่าง = ส่งไป TELEGRAM_CHAT_ID
TELEGRAM_ALERT_CHAT_ID=
# ข้อความทดสอบ (npm run telegram:test / watchdog.sh --test) — เช่น แชทส่วนตัวของผู้ดูแล · เว้นว่าง = ส่งไป TELEGRAM_CHAT_ID
TELEGRAM_TEST_CHAT_ID=
# ล่มติดกันกี่นาทีจึงแจ้ง (สั้นกว่านี้ไม่แจ้ง กันแจ้งพร่ำเพรื่อตอนเครือข่ายสะดุด)
ALERT_DOWN_MINUTES=5
# ลิงก์เว็บ (https) สำหรับปุ่ม "เปิดดูในระบบ" ใน Telegram
APP_PUBLIC_URL=

# CORS ไม่จำเป็นเมื่อหน้าเว็บกับ API อยู่โดเมนเดียวกันผ่าน nginx (ค่าเริ่มต้นใช้ได้)
# CORS_ORIGIN=

# โฟลเดอร์ข้อมูล (เว้นว่าง = backend/data) — ถ้าย้าย ต้องแก้ ReadWritePaths ใน deploy/systemd/bsth-dashboard.service ด้วย
DATA_DIR=

CACHE_PREWARM_MINUTES=30
CACHE_TTL_TODAY_MINUTES=30
CACHE_TTL_PAST_HOURS=24
HOSXP_MAX_CONCURRENT=2
AUDIT_KEEP_DAYS=180
MEM_WARN_MB=1024
MEM_FREE_WARN_PCT=5
DATA_WARN_MB=500
LOG_IP_RATE_PER_MIN=300
SSE_MAX_CLIENTS=500
# ช่องสัญญาณสดต่อเครื่อง (IP) · login ผิดรวมทุกชื่อจากเครื่องเดียวใน 5 นาที ก่อนพักทั้งเครื่อง
SSE_MAX_PER_IP=20
LOGIN_MAX_IP_FAILS=30

# แสดงการเช็คเบื้องหลังของหน้าเว็บ (สถานะระบบ / กระดิ่ง) ทีละบรรทัดในเทอร์มินัล — ค่าเริ่มต้นซ่อน นับรวมในสรุปรายชั่วโมงแทน
LOG_BACKGROUND=
