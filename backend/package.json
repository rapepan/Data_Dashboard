{
  "name": "bsth-ops-backend",
  "version": "0.1.0",
  "private": true,
  "description": "DATA BSTH - Backend API (Fastify, layered architecture)",
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "telegram:chat-id": "tsx scripts/telegram.ts chat-id",
    "telegram:test": "tsx scripts/telegram.ts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.2",
    "fastify": "^5.1.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
